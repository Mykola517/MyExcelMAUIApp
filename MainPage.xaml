<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MyExcelMAUIApp"
             x:Class="MyExcelMAUIApp.MainPage">

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="Файл">
            <MenuFlyoutItem Text="Зберегти" Clicked="SaveButton_Clicked" />
            <MenuFlyoutItem Text="Прочитати" Clicked="ReadButton_Clicked" />
            <MenuFlyoutItem Text="Вийти" Clicked="ExitButton_Clicked" />
        </MenuBarItem>
        <MenuBarItem Text="Таблиця">
            <MenuFlyoutItem Text="Порахувати" Clicked="CalculateButton_Clicked" />
            <MenuFlyoutItem Text="Перемкнути режим ВИРАЗ/ЗНАЧЕННЯ" Clicked="ModeButton_Clicked" />
            <MenuFlyoutItem Text="Додати рядок" Clicked="AddRowButton_Clicked" />
            <MenuFlyoutItem Text="Видалити рядок" Clicked="DeleteRowButton_Clicked" />
            <MenuFlyoutItem Text="Додати стовпчик" Clicked="AddColumnButton_Clicked" />
            <MenuFlyoutItem Text="Видалити стовпчик" Clicked="DeleteColumnButton_Clicked" />
        </MenuBarItem>
        <MenuBarItem Text="Довідка">
            <MenuFlyoutItem Text="Довідка" Clicked="HelpButton_Clicked" />
            <MenuFlyoutItem Text="Про програму" Clicked="AboutButton_Clicked" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <FlexLayout Wrap="Wrap">
            <Button Text="Зберегти" Clicked="SaveButton_Clicked" Margin="2" />
            <Button Text="Прочитати" Clicked="ReadButton_Clicked" Margin="2" />
            <Button Text="Порахувати" Clicked="CalculateButton_Clicked" Margin="2" />
            <Button x:Name="modeButton" Text="Режим: ВИРАЗ" Clicked="ModeButton_Clicked" Margin="2" />
            <Button Text="Додати рядок" Clicked="AddRowButton_Clicked" Margin="2" />
            <Button Text="Видалити рядок" Clicked="DeleteRowButton_Clicked" Margin="2" />
            <Button Text="Додати стовпчик" Clicked="AddColumnButton_Clicked" Margin="2" />
            <Button Text="Видалити стовпчик" Clicked="DeleteColumnButton_Clicked" Margin="2" />
            <Button Text="Довідка" Clicked="HelpButton_Clicked" Margin="2" />
            <Button Text="Вийти" Clicked="ExitButton_Clicked" Margin="2" />
        </FlexLayout>

        <Entry x:Name="textInput" Placeholder="Тут показується вираз або помилка вибраної клітинки"
               IsReadOnly="True" Grid.Row="1" />

        <ScrollView Grid.Row="2" Orientation="Both">
            <Grid x:Name="grid">
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
